# ──────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — MapaEngine
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees el .env con valores; solo este .env.example.
# ──────────────────────────────────────────────────────────────

# ── Agentes de IA ─────────────────────────────────────────────
# No requieren variables aquí:
#  - Claude Code se autentica solo (login de suscripción o su propia API key en
#    tu shell); no lee este .env.
#  - opencode (Qwen + DeepSeek) usa el gateway de opencode ('opencode auth login').

# ── Base de datos (PostgreSQL + PostGIS) ──────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── GeoServer ─────────────────────────────────────────────────
GEOSERVER_URL=
GEOSERVER_ADMIN_USER=
GEOSERVER_ADMIN_PASSWORD=

# ── Authentik (OIDC / OAuth2) ─────────────────────────────────
AUTHENTIK_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=

# ── Backend (FastAPI) ─────────────────────────────────────────
# Secreto para firmar/validar sesiones o tokens internos.
APP_SECRET_KEY=
