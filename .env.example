# ──────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — MapaEngine
#
# REGLA:
#   Este archivo es SOLO una plantilla. NO escribas valores reales aquí:
#   usa marcadores <descripción> entre < >. Las credenciales NUNCA van en
#   este archivo (se manejan con Docker secrets; ver ./secrets/).
#   Para usarlo: copia este archivo a `.env` y rellena los valores reales allí
#   (`.env` está ignorado por git). El compose tiene defaults, así que `.env`
#   es opcional para desarrollo local.
# ──────────────────────────────────────────────────────────────

# Agentes de IA: no requieren variables aquí (ver AGENTS.md).

# ── Proyecto ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=<nombre del proyecto para Docker Compose>

# ── PostGIS (datos principales) ───────────────────────────────
POSTGRES_HOST=<host de la base de datos>
POSTGRES_PORT=<puerto de PostgreSQL>
POSTGRES_DB=<nombre de la base principal>
POSTGRES_USER=<usuario de la base principal>

# ── Authentik: base y usuario propios en la MISMA PostGIS ─────
AUTHENTIK_POSTGRES_DB=<nombre de la base de Authentik>
AUTHENTIK_POSTGRES_USER=<usuario de Authentik>

# ── GeoServer ─────────────────────────────────────────────────
GEOSERVER_ADMIN_USER=<usuario admin de GeoServer>

# ── Puertos publicados en localhost ───────────────────────────
GEOSERVER_PORT=<puerto de GeoServer>
PYCSW_PORT=<puerto de pycsw>
AUTHENTIK_PORT=<puerto de Authentik>
REDIS_PORT=<puerto de Redis>
BACKEND_PORT=<puerto del backend>
FRONTEND_PORT=<puerto del frontend>
